// Harvard FASRC (Cannon) — database paths
// These are the default database paths on hutlab storage.
// Override any value on the CLI: --human_genome /path/to/other/db
params {
    human_genome      = '/n/huttenhower_lab/data/kneaddata_databases/hg38'
    metaphlan_db      = '/n/huttenhower_lab/tools/metaphlan4/rocky8/v4.0.6_vOct_fixed/lib/python3.10/site-packages/metaphlan/metaphlan_databases'
    metaphlan_index   = 'mpa_vOct22_CHOCOPhlAnSGB_202403'
    metaphlan_version = 'metaphlan_v3'   // hutlab builds use v3-style CLI flags
    humann_db         = '/n/huttenhower_lab/tools/nextflow/databases/humann4'
    humann_version    = 'humann_v4a'
    strainphlan_db    = null             // auto-resolved from metaphlan_db
    baqlava_db        = null
    phylophlan_path   = null             // set if running sgb_pipeline
}
