// Harvard FASRC (Cannon) — database paths
// These are the default database paths on hutlab storage.
// Override any value on the CLI: --human_genome /path/to/other/db
params {
    human_genome      = '/n/lab_storage/huttenhower_lab/data/kneaddata_databases/hg38'
    metaphlan_db      = '/n/lab_storage/huttenhower_lab/tools/metaphlan4/rocky8/v4.0.6_vOct_fixed/lib/python3.10/site-packages/metaphlan/metaphlan_databases'
    metaphlan_index   = 'mpa_vOct22_CHOCOPhlAnSGB_202403'
    metaphlan_version = 'metaphlan_4.0.6_fixed'   // vOct22 build: v3-style CLI flags
    humann_db         = '/n/lab_storage/huttenhower_lab/tools/nextflow/databases/humann4'
    humann_version    = 'humann_v4a'
    strainphlan_db    = null             // auto-resolved from metaphlan_db
    baqlava_db        = null
    // Assembly (MAG/SGB) workflow. checkm2 locates its own database through the
    // CHECKM2DB variable exported by rocky8/biobakeryworkflows/3.2, so only the
    // PhyloPhlAn database folder needs naming here.
    phylophlan_path   = '/n/lab_storage/huttenhower_lab/tools/biobakery_workflows/biobakery_workflows_databases/phylophlan'
}
