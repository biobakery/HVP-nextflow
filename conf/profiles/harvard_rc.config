// Harvard FASRC (Cannon) — SLURM hsph partition, hutlab module system
process {
    executor = 'slurm'
    queue    = 'hsph'

    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        beforeScript = 'module use /n/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load rocky8/kneaddata/0.12.0-devel'
        memory = '16.G'
        time   = '8.h'
        cpus   = 8
    }

    withName: metaphlan {
        // MetaPhlAn 4.1.1 — mpa_vJun23_CHOCOPhlAnSGB_202307 is the only db compatible with humann3.9
        beforeScript = 'module use /n/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/metaphlan4/4.1.1'
        memory = '32.G'
        time   = '4.h'
        cpus   = 8
    }

    withName: metaphlan_bzip {
        memory = '4.G'
        time   = '1.h'
        cpus   = 1
    }

    withName: metaphlan_merge {
        memory = '8.G'
        time   = '1.h'
        cpus   = 1
    }

    withName: humann {
        // humann3.9 — compatible with metaphlan4.1.1 vJun23 db and baqlava
        beforeScript = 'module use /n/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load rocky8/humann3/3.9-devel'
        memory = '32.G'
        time   = '12.h'
        cpus   = 8
    }

    withName: 'humann_regroup|humann_rename|humann_merge' {
        beforeScript = 'module use /n/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load rocky8/humann3/3.9-devel'
        memory = '16.G'
        time   = '2.h'
        cpus   = 2
    }

    withName: baqlava {
        // baqlava module auto-loads humann3/3.9-devel and anadama2
        beforeScript = 'module use /n/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load rocky8/baqlava/0.5.0-devel'
        memory = '16.G'
        time   = '8.h'
        cpus   = 4
    }

    withName: 'sample2markers|strainphlan' {
        beforeScript = 'module use /n/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load rocky8/metaphlan4/4.1.1'
        memory = '16.G'
        time   = '8.h'
        cpus   = 8
    }
}
