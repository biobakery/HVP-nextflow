// Harvard FASRC (Cannon) — SLURM hsph partition, hutlab module system
process {
    executor = 'slurm'
    queue    = 'hsph'

    withName: 'single_end_kneaddata|paired_end_kneaddata' {
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load rocky8/kneaddata/0.12.0-devel'
        memory = '16.G'
        time   = '8.h'
        cpus   = 8
    }

    withName: metaphlan {
        // MetaPhlAn 4.0.6_vOct22_fixed — mpa_vOct22_CHOCOPhlAnSGB_202403, compatible with HUMAnN 4 and BAQLaVa 1.2.0
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/metaphlan4/4.0.6_vOct22_fixed'
        memory = '32.G'
        time   = '4.h'
        cpus   = 8
    }

    withName: metaphlan_bzip {
        // bzip2 the SAM outputs
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/metaphlan4/4.0.6_vOct22_fixed'
        memory = '4.G'
        time   = '1.h'
        cpus   = 1
    }

    withName: metaphlan_merge {
        // needs merge_metaphlan_tables.py from the metaphlan module
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/metaphlan4/4.0.6_vOct22_fixed'
        memory = '8.G'
        time   = '1.h'
        cpus   = 1
    }

    withName: humann {
        // HUMAnN 4.0-alpha-1-final — required for BAQLaVa 1.2.0; auto-loads metaphlan4/4.0.6_vOct22_fixed
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/humann4/4.0-alpha-1-final'
        memory = '32.G'
        time   = '12.h'
        cpus   = 8
    }

    withName: 'humann_regroup|humann_rename|humann_merge' {
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/humann4/4.0-alpha-1-final'
        memory = '16.G'
        time   = '2.h'
        cpus   = 2
    }

    withName: baqlava {
        // BAQLaVa 1.2.0-devel — auto-loads humann4/4.0-alpha-1-final, anadama2, metaphlan4/4.0.6_vOct22_fixed
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/baqlava/1.2.0-devel'
        // BAQLaVa runs HUMAnN internally (bacterial depletion + DIAMOND
        // translated search), so it needs at least as much memory as the humann
        // process above. At 16.G it was OOM-killed at 15.69G peak.
        memory = { 48.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        cpus   = 4
    }

    withName: 'sample2markers|strainphlan' {
        // MetaPhlAn 4.0.6_vOct22_fixed to match the mpa_vOct22 database used by the rest of the stack
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/metaphlan4/4.0.6_vOct22_fixed'
        memory = '16.G'
        time   = '8.h'
        cpus   = 8
    }

    withName: version_log {
        // Run locally so the process inherits the login-node module environment.
        // Load all tool modules so version strings are captured correctly.
        executor     = 'local'
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load python/3.10.9-fasrc01; module load gcc/9.5.0-fasrc01; module load rocky8/kneaddata/0.12.0-devel; module load rocky8/baqlava/1.2.0-devel'
    }

    // ── assembly (MAG/SGB) workflow ────────────────────────────────────────
    // All of these come from a single module: rocky8/biobakeryworkflows/3.2
    // provides megahit, bowtie2, samtools, metabat2, jgi_summarize_bam_contig_depths,
    // checkm2, phylophlan, mash, fastANI and assembly-stats, and sets CHECKM2DB
    // and PHYLOPHLAN_PATH. Keeping it to one module keeps the nextflow assembly
    // workflow on exactly the same stack as `biobakery_workflows assembly`.
    withName: megahit {
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load rocky8/biobakeryworkflows/3.2'
        memory = '64.G'
        time   = '24.h'
        cpus   = 8
    }

    withName: 'align_and_depth|metabat2|checkm2' {
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load rocky8/biobakeryworkflows/3.2'
        memory = '32.G'
        time   = '12.h'
        cpus   = 8
    }

    withName: phylophlan_metagenomic {
        // reads the full SGB sketch database, so give it room and time
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load rocky8/biobakeryworkflows/3.2'
        memory = '32.G'
        time   = '24.h'
        cpus   = 8
    }

    withName: 'checkm2_merge|checkm2_wrangling|mag_n50|phylophlan_merge|mash_list_inputs|mash_sketch|mash_paste|mash_dist|sgb_cluster|merge_tax_abundance' {
        beforeScript = 'module use /n/lab_storage/huttenhower_lab/tools/hutlab/src/modules_rocky8; module load rocky8/biobakeryworkflows/3.2'
        memory = '16.G'
        time   = '4.h'
        cpus   = 4
    }
}
