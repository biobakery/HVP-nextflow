# Nextflow run state and output
.nextflow*
work/
work_test*/
output/
results/

# Integration test runs (tests/run_tests.sh writes both)
tests/results/
tests/work/

# Scratch output of tests/fixtures/phanta/tiny_db/build.sh, which the READMEs
# invoke as `-o /w/build/tiny`. Holds the raw NCBI downloads, the dustmasker
# output and the Bracken build intermediates. The parts worth keeping are copied
# into tests/fixtures/phanta/ by hand and committed; this tree is disposable.
/build/

# Large intermediate files inside the committed tutorial reference output
tests/data/tutorial_output/**/*.sam
tests/data/tutorial_output/**/*.sam.bz2
tests/data/tutorial_output/kneaddata/*.fastq.gz
tests/data/tutorial_output/metaphlan/mpa_vOct22_CHOCOPhlAnSGB_202403/
tests/data/tutorial_output/**/.anadama/

.DS_Store
# python bytecode from the bin/scripts helpers
__pycache__/
*.pyc

# JetBrains project files. Per-developer state: module layout, an output path
# for a language this repo does not build, and a "this is a git repo" mapping.
# Nothing in the pipeline reads them, and they churn whenever anyone opens the
# project. IntelliJ regenerates them on first open.
.idea/
