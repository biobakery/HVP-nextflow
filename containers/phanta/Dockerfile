# ─────────────────────────────────────────────────────────────────────────────
# Phanta tool image — Kraken2 + Bracken + the Python stack the Phanta scripts
# run on. No databases: phanta_db is staged per site (conf/databases/*.config).
#
# This image is the *canonical software environment* for Phanta, not a
# convenience. The four published tables are required to be byte-identical
# between the upstream Phanta baseline and this repository's port, and every
# Phanta script writes through pandas.to_csv, whose float formatting is
# version-sensitive. Both sides of that comparison must therefore run the same
# pandas and numpy. Upstream pins neither (phanta_env.yaml pins only kraken2 and
# snakemake), so the pinning happens here.
#
# Everything is installed from conda-lock.txt, an @EXPLICIT list of exact
# package URLs. Version specs alone are not enough: a conda solve is a moving
# target, and re-solving months from now would silently drift pandas or numpy
# and break byte-identity. Regenerate the lock only deliberately — see README.md
# — and treat a regeneration as a baseline-refresh trigger.
#
# snakemake is included because the upstream baseline is generated by running
# Phanta's own Snakefile *in this image*; that is the only way to guarantee the
# baseline and the port share a pandas. It is unused by the Nextflow workflow.
#
# Build (linux/amd64 always, even on an arm64 laptop — AWS Batch is amd64 and
# bioconda publishes no arm64 build of kraken2):
#
#   docker build --platform linux/amd64 -t phanta:<tag> containers/phanta
#
# Push and digest capture: see containers/phanta/README.md.
# ─────────────────────────────────────────────────────────────────────────────

FROM mambaorg/micromamba:1.5.8

USER root

# procps: Nextflow's task metrics shell out to `ps`.
# bc:     phanta_calc_total_reads.sh does its arithmetic with it, and refuses
#         to run without it (upstream calc_total_reads.sh exits 1 on a missing bc).
RUN apt-get update && apt-get install -y --no-install-recommends \
        procps \
        bc \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY conda-lock.txt /tmp/conda-lock.txt
RUN micromamba install -y -n base -f /tmp/conda-lock.txt \
    && micromamba clean -afy \
    && rm /tmp/conda-lock.txt

ENV PATH="/opt/conda/bin:${PATH}"

# Fail the build rather than ship an image whose tools do not start.
RUN kraken2 --version \
    && bracken -v 2>&1 | head -1 \
    && python -c "import pandas, numpy, Bio; print(pandas.__version__, numpy.__version__)" \
    && command -v kraken2-build bracken-build bc

WORKDIR /data
CMD ["bash"]
