// ═════════════════════════════════════════════════════════════════════════════
// biobakery/hvp — Human Virome Project workflows
//
// This file is only an index. Each kind of setting has one home, and the layers
// are applied in this order — later wins:
//
//   1. conf/params.config             GLOBAL DEFAULTS. Every parameter's default
//                                     value. Nothing site- or run-specific.
//   2. conf/base.config               DEFAULT RESOURCES. cpus/memory/time per
//                                     process, capped by params.max_*.
//   3. conf/reports.config            RUNTIME. The timeline/report/trace/dag
//                                     files written next to the output.
//   4. conf/profiles/<site>.config    SITE RUNTIME (-profile). Executor, queue,
//                                     containers, tool environment, and the
//                                     resource overrides that site needs.
//   5. conf/databases/<site>.config   SITE DEFAULTS (-profile). Database paths
//                                     and the tool versions tied to them.
//   6. -params-file my-params.yaml    THIS RUN. conf/harvard_rc.yaml is a
//                                     template.
//   7. --readsdir /path ... on the CLI THIS RUN, highest precedence.
//
// So: to change a default for everyone, edit conf/params.config. To change
// something about a machine, edit its profile. To change one run, use a params
// file or the command line and edit nothing.
//
// Which components exist is not configuration but the registry,
// conf/components.json. The architecture diagram is generated from it and from
// workflows/hvp.nf by bin/make_diagrams.py.
// ═════════════════════════════════════════════════════════════════════════════

manifest {
    name            = 'biobakery/hvp'
    author          = 'Huttenhower Lab'
    homePage        = 'https://github.com/biobakery/HVP-nextflow'
    description     = 'Human Virome Project workflows: an orchestrator over pluggable read-based and assembly-based virome components'
    mainScript      = 'main.nf'
    version         = '0.1.0dev'
    nextflowVersion = '!>=24.04.0'
}

// ── Nextflow plugins ─────────────────────────────────────────────────────────
// nf-schema: parameter validation against nextflow_schema.json, --help, and the
// parameter summary printed at launch (subworkflows/local/utils_hvp_pipeline).
plugins {
    id 'nf-schema@2.1.0'
}

validation {
    help {
        enabled = true
        command = "nextflow run biobakery/HVP-nextflow -profile <site> --readsdir <fastqs> --outdir <dir>"
    }
    // The site profiles set database params that a given run may not use.
    failUnrecognisedParams = false
}

// ── 1-3: defaults that apply everywhere ──────────────────────────────────────
includeConfig 'conf/params.config'
includeConfig 'conf/base.config'
includeConfig 'conf/reports.config'

// ── 4-5: the machine this run is on ──────────────────────────────────────────
// A profile pairs a runtime (executor, queue, tool environment) with that
// site's database paths. Both halves are needed, which is why they are selected
// together rather than being two separate -profile arguments.
profiles {

    // No executor configuration: run every task on this machine.
    local     { includeConfig 'conf/profiles/local.config' }
    standard  { includeConfig 'conf/profiles/local.config' }

    // Harvard FASRC (Cannon), SLURM + hutlab modules. The default for the lab.
    harvard_rc {
        includeConfig 'conf/profiles/harvard_rc.config'
        includeConfig 'conf/databases/harvard_rc.config'
    }

    // Tufts HPC, SLURM + Apptainer containers.
    tufts_hpc {
        includeConfig 'conf/profiles/tufts_hpc.config'
        includeConfig 'conf/databases/tufts.config'
    }

    // AWS Batch. Incomplete — see the header of conf/profiles/aws.config.
    amazon    { includeConfig 'conf/profiles/aws.config' }
}
