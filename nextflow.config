plugins {
    id 'nf-amazon'
}

// ── Include base resource config ─────────────────────────────────────────────
includeConfig 'conf/base.config'

// ── Global parameters ────────────────────────────────────────────────────────
params {

    // ── Workflow selector ──────────────────────────────────────────────────
    // mgx | mtx | mgx_mtx | 16s | vis | stats | assembly
    workflow = 'mgx'

    // ── Input / output ─────────────────────────────────────────────────────
    readsdir     = null
    outdir       = 'results'
    // Library layout. paired_end is auto-detected from the read filenames: if the
    // pair identifier is never found the run falls back to single-end with a
    // warning. Set single_end = true to force single-end even when pairs exist.
    paired_end       = true
    single_end       = false
    pair_identifier  = '_R{1,2}'
    // Leave filepattern null to derive it from the layout, so single-end runs do
    // not have to restate it. Set it explicitly to override.
    filepattern      = null
    filepattern_paired = '*_R{1,2}*.fastq.gz'
    filepattern_single = '*.fastq.gz'

    // ── Tool toggles ───────────────────────────────────────────────────────
    run_qc                   = true
    run_taxonomic_profiling  = true
    run_functional_profiling = true
    run_strain_profiling     = false  // StrainPhlAn (SGB mode)
    run_viral_profiling      = false  // BAQLaVa viral profiling

    // ── QC options (KneadData) ─────────────────────────────────────────────
    kneaddata_bypass_trim               = false
    kneaddata_remove_intermediate_files = true

    // ── Taxonomic profiling options (MetaPhlAn) ────────────────────────────
    metaphlan_version        = 'metaphlan_v4'  // metaphlan_v3 | metaphlan_v4 | metaphlan_4.0.6_fixed
    metaphlan_analysis_type  = 'rel_ab_w_read_stats'  // rel_ab | rel_ab_w_read_stats | marker_ab_table
    metaphlan_read_min_len   = 70

    // ── Functional profiling options (HUMAnN) ─────────────────────────────
    humann_version                  = 'humann_v37'  // humann_v37 | humann_v4a
    humann_bypass_prescreen         = false
    humann_bypass_nucleotide_search = false
    run_humann_regroup              = true
    run_humann_rename               = true
    run_humann_merge                = true
    humann_regroup_grouping         = 'uniref90_rxn'  // uniref90_rxn | uniref90_ko | uniref90_eggnog | uniref90_pfam
    // humann_rename_table takes a different vocabulary to humann_regroup_table;
    // leave null to map from humann_regroup_grouping automatically
    humann_rename_names             = null  // kegg-orthology | ec | metacyc-rxn | metacyc-pwy | pfam | eggnog | go | infogo1000 | uniref90

    // ── Viral profiling options (BAQLaVa) ──────────────────────────────────
    baqlava_bypass_depletion = false  // set true for test samples with 0 prescreen species

    // ── Strain profiling options (StrainPhlAn) ────────────────────────────
    strainphlan_clades              = null         // null = all detected; or comma-separated list
    strainphlan_phylophlan_mode     = 'accurate'   // accurate | fast
    strainphlan_marker_in_n_samples = 2

    // ── SGB pipeline options (MAG assembly + binning + SGB clustering) ─────
    megahit_min_contig_length       = 2500
    // Catch-all extra arguments, appended verbatim to each tool's command line.
    // Mirrors the anadama2 workflow's "--<tool>-options" parameters, and avoids
    // having to surface every flag each tool supports as its own param.
    kneaddata_options               = ''
    metaphlan_options               = ''
    humann_options                  = ''
    baqlava_options                 = ''
    strainphlan_options             = ''
    megahit_options                 = ''
    metabat_options                 = ''
    checkm_predict_options          = ''
    checkm_coverage_options         = ''
    phylophlan_metagenomic_options  = ''
    mash_sketch_options             = ''
    sgb_completeness                = 50    // minimum MAG completeness %
    sgb_contamination               = 10    // maximum MAG contamination %
    sgb_abundance_type              = 'by_sample'  // by_sample | by_dataset
    sgb_gc_length_stats             = false

    // ── Database paths (must be set per environment) ───────────────────────
    host_genome    = null
    metaphlan_db    = null
    metaphlan_index = 'mpa_vJun23_CHOCOPhlAnSGB_202307'
    humann_db       = null
    strainphlan_db  = null  // auto-resolved from metaphlan_db when null
    baqlava_db      = null  // uses bundled db when null
    phylophlan_path = null  // required only for assembly workflow

    // ── Version logging ────────────────────────────────────────────────────
    log_versions = true

    // ── Resource caps ──────────────────────────────────────────────────────
    max_memory = '128.GB'
    max_cpus   = 32
    max_time   = '240.h'
}

// ── Profiles ─────────────────────────────────────────────────────────────────
profiles {
    standard  { includeConfig 'conf/profiles/local.config' }
    local     { includeConfig 'conf/profiles/local.config' }
    tufts_hpc {
        includeConfig 'conf/profiles/tufts_hpc.config'
        includeConfig 'conf/databases/tufts.config'
    }
    harvard_rc {
        includeConfig 'conf/profiles/harvard_rc.config'
        includeConfig 'conf/databases/harvard_rc.config'
    }
    amazon    { includeConfig 'conf/profiles/aws.config' }
    // Legacy profile — kept for backward compatibility
    engaging {
        process {
            executor = 'slurm'
            queue    = 'newnodes'
            withName: 'single_end_kneaddata|paired_end_kneaddata' { memory = '8.G';  time = '8.h';  cpus = 8  }
            withName: metaphlan                                    { memory = '8.G';  time = '4.h';  cpus = 8  }
            withName: humann                                       { memory = '16.G'; time = '12.h'; cpus = 16 }
        }
    }
}

// ── Execution reports ─────────────────────────────────────────────────────────
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"; fields = 'task_id,hash,name,status,exit,realtime,cpus,memory,disk,rss,vmem,peak_rss,peak_vmem' }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg" }
